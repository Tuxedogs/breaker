{
  "rewrites": [
    {
      "source": "/api/user/inventory/stacks/:id",
      "destination": "/api/user/inventory/stacks/[id]"
    },
    {
      "source": "/api/user/inventory/locations/:id",
      "destination": "/api/user/inventory/locations/[id]"
    },
    {
      "source": "/api/missions/family/:familyKey/variants",
      "destination": "/api/missions/family/[familyKey]/variants"
    },
    {
      "source": "/api/missions/family/:familyKey",
      "destination": "/api/missions/family/[familyKey]"
    },
    {
      "source": "/api/missions/variant/:variantKey",
      "destination": "/api/missions/variant/[variantKey]"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
