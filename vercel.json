{
  "functions": {
    "api/missions/[...path].ts": {
      "includeFiles": "server-data/missions/{mission_browser_index.json,families/**,family-variants/**,variants/**}",
      "excludeFiles": "server-data/missions/mission_{variants,locations,rewards,prerequisites,families,concepts,reputation,unresolved_refs,browse_groups}.json"
    },
    "api/crafting/[...path].ts": {
      "includeFiles": "server-data/crafting/**"
    },
    "api/v1/fitting/[...path].ts": {
      "includeFiles": "server-data/fitting/**"
    },
    "api/mining/[...path].ts": {
      "includeFiles": "server-data/mining/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/user/inventory/sync",
      "destination": "/api/user/inventory-router"
    },
    {
      "source": "/api/user/inventory/stacks",
      "destination": "/api/user/inventory-router"
    },
    {
      "source": "/api/user/inventory/stacks/:id",
      "destination": "/api/user/inventory-router"
    },
    {
      "source": "/api/user/inventory/locations/:id",
      "destination": "/api/user/inventory-router"
    },
    {
      "source": "/api/user/inventory/build-queue-items/:id",
      "destination": "/api/user/inventory-router"
    },
    {
      "source": "/api/user/inventory/build-queues/:id/items",
      "destination": "/api/user/inventory-router"
    },
    {
      "source": "/api/user/inventory/build-queues/:id",
      "destination": "/api/user/inventory-router"
    },
    {
      "source": "/api/missions/:path*",
      "destination": "/api/missions/[...path]"
    },
    {
      "source": "/api/crafting/blueprint-sources",
      "destination": "/api/crafting/[...path]"
    },
    {
      "source": "/api/crafting/blueprint-sources/index",
      "destination": "/api/crafting/[...path]"
    },
    {
      "source": "/api/crafting/blueprint-sources/batch",
      "destination": "/api/crafting/[...path]"
    },
    {
      "source": "/api/crafting/blueprint-rewards/:path*",
      "destination": "/api/crafting/[...path]"
    },
    {
      "source": "/api/crafting/component-cards/index",
      "destination": "/api/crafting/[...path]"
    },
    {
      "source": "/api/crafting/component-cards/facets",
      "destination": "/api/crafting/[...path]"
    },
    {
      "source": "/api/crafting/component-cards/browse",
      "destination": "/api/crafting/[...path]"
    },
    {
      "source": "/api/crafting/component-cards/:id",
      "destination": "/api/crafting/[...path]"
    },
    {
      "source": "/api/crafting/recipes/index",
      "destination": "/api/crafting/[...path]"
    },
    {
      "source": "/api/crafting/recipes/batch",
      "destination": "/api/crafting/[...path]"
    },
    {
      "source": "/api/crafting/recipes/:id",
      "destination": "/api/crafting/[...path]"
    },
    {
      "source": "/api/crafting/reference/:path*",
      "destination": "/api/crafting/[...path]"
    },
    {
      "source": "/api/v1/fitting/:path*",
      "destination": "/api/v1/fitting/[...path]"
    },
    {
      "source": "/api/mining/:path*",
      "destination": "/api/mining/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
