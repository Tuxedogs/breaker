{
    "name": "moonbreaker-docs",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:fixtures": "vite --mode fixtures",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "ui:inventory": "playwright test --config=playwright.inventory.config.ts",
        "ui:build-queue": "playwright test --config=playwright.build-queue.config.ts",
        "content:check": "node --import tsx scripts/validate-content.mts",
        "api:check": "node --import tsx scripts/validate-public-api.mts",
        "fitting:test": "node --import tsx --test server/fitting/fitting.routes.test.ts src/lib/fitting/fittingBuildContext.test.ts src/lib/fitting/fittingComponentStore.test.ts src/lib/crafting/resolveEntityClass.test.ts src/lib/crafting/resolveCraftingDisplayName.test.ts src/lib/fitting/fittingStatProjection.test.ts src/lib/crafting/fpsComponentCardDetail.test.ts src/lib/crafting/craftStatViewModel.test.ts src/lib/logistics/buildQueueCraftStats.test.ts src/components/logistics/buildQueueStatsGroups.test.ts",
        "missions:shape": "node --import tsx scripts/shape-mission-browser-data.mts",
        "crafting:shape-blueprint-sources": "node --import tsx scripts/shape-blueprint-sources-data.mts",
        "crafting:shape-component-cards": "node --import tsx scripts/shape-component-card-data.mts",
        "crafting:shape-recipes": "node --import tsx scripts/shape-recipe-data.mts",
        "crafting:shape-reference": "node --import tsx scripts/shape-crafting-reference-data.mts",
        "crafting:shape": "npm run crafting:shape-blueprint-sources && npm run crafting:shape-component-cards && npm run crafting:shape-recipes && npm run crafting:shape-reference",
        "crafting:blueprint-sources:verify": "node --import tsx scripts/verify-crafting-blueprint-sources-api.mts",
        "crafting:component-cards:verify": "node --import tsx scripts/verify-component-card-data.mts",
        "refinery:import": "node --import tsx scripts/import-refinery-yields.mts",
        "refinery:validate": "node --import tsx scripts/validate-refinery.mts",
        "crafting:card-index": "tsx D:/scintel/scripts/crafting/generate-component-card-index.ts",
        "preview": "vite preview",
        "changelog": "git-cliff -c cliff.toml -o CHANGELOG.md",
        "release:tag": "node scripts/release-tag.js",
        "alpha:import": "node --import tsx scripts/alpha-threshold/import-sources.mts",
        "alpha:fetch-erkul": "node --import tsx scripts/alpha-threshold/fetch-erkul-dumps.mts",
        "alpha:fetch-ptu-ships": "node --import tsx scripts/alpha-threshold/fetch-erkul-ptu-ships.mts",
        "alpha:images": "node --import tsx scripts/alpha-threshold/import-wiki-images.mts",
        "alpha:card-stats": "node --import tsx scripts/alpha-threshold/import-ship-card-stats.mts",
        "alpha:shield-profiles": "node --import tsx scripts/alpha-threshold/import-ship-shield-profiles.mts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push"
    },
    "dependencies": {
        "@mdx-js/react": "^3.1.1",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.5.0",
        "@supabase/supabase-js": "^2.105.4",
        "@vercel/speed-insights": "^1.3.1",
        "drizzle-orm": "^0.45.2",
        "framer-motion": "^12.34.3",
        "postgres": "^3.4.9",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router-dom": "^7.13.0",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "tesseract.js": "^7.0.0",
        "three": "^0.183.1",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@mdx-js/rollup": "^3.1.1",
        "@playwright/test": "^1.61.1",
        "@types/mdx": "^2.0.13",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "autoprefixer": "^10.4.24",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "msw": "^2.15.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.17",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.48.0",
        "vite": "^7.3.1",
        "vite-plugin-svgr": "^4.5.0"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
